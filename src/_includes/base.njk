<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>
    (function () {
      document.documentElement.setAttribute("data-js", "");
      try {
        var theme = localStorage.getItem("theme");
        if (theme === "dark" || theme === "light") {
          document.documentElement.setAttribute("data-theme", theme);
        }
      } catch (error) {}
    })();
  </script>
  <title>{% if pageTitle %}{{ pageTitle }}｜{{ site.name }}{% elif kind %}{{ title }}｜{{ site.name }}{% else %}{{ site.name }}｜{{ site.nameEn }}{% endif %}</title>
  <meta name="description" content="{% if description %}{{ description }}{% elif excerpt %}{{ excerpt }}{% else %}{{ site.description }}{% endif %}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:type" content="{% if kind %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{% if pageTitle %}{{ pageTitle }}｜{{ site.name }}{% elif kind %}{{ title }}｜{{ site.name }}{% else %}{{ site.name }}｜{{ site.nameEn }}{% endif %}">
  <meta property="og:description" content="{% if description %}{{ description }}{% elif excerpt %}{{ excerpt }}{% else %}{{ site.description }}{% endif %}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {% if kind %}
  <meta property="article:published_time" content="{{ date | isoDate }}">
  {% endif %}
  {% set shareImage = cover or site.ogImage %}
  {% if shareImage %}
  <meta property="og:image" content="{{ shareImage | absoluteUrl(site.url) }}">
  {% if cover and coverAlt %}
  <meta property="og:image:alt" content="{{ coverAlt }}">
  {% elif (not cover) and site.ogImageAlt %}
  <meta property="og:image:alt" content="{{ site.ogImageAlt }}">
  {% endif %}
  {% endif %}
  <meta name="author" content="{{ site.author }}">
  <meta name="twitter:card" content="{% if shareImage %}summary_large_image{% else %}summary{% endif %}">
  {% if shareImage %}
  <meta name="twitter:image" content="{{ shareImage | absoluteUrl(site.url) }}">
  {% if cover and coverAlt %}
  <meta name="twitter:image:alt" content="{{ coverAlt }}">
  {% endif %}
  {% endif %}
  {% if robots %}
  <meta name="robots" content="{{ robots }}">
  {% endif %}
  <meta name="theme-color" content="#f6f1e7" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#141210" media="(prefers-color-scheme: dark)">
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="/feed.xml">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/site.css">
</head>
<body>
  <a class="skip" href="#main">跳到內容</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/">
        <span class="seal" aria-hidden="true">衝</span>
        <span class="brand-text">
          <span class="brand-zh">{{ site.name }}</span>
          <span class="brand-en">{{ site.nameEn }}</span>
        </span>
      </a>
      <nav class="nav" aria-label="主要選單">
        <a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>首頁</a>
        <a href="/exclusives/"{% if "/exclusives/" in page.url %} aria-current="page"{% endif %}>長文</a>
        <a href="/digests/"{% if "/digests/" in page.url %} aria-current="page"{% endif %}>Digest</a>
        <a href="/about/"{% if "/about/" in page.url %} aria-current="page"{% endif %}>關於</a>
        <a href="/newsletter/"{% if "/newsletter/" in page.url %} aria-current="page"{% endif %}>訂閱</a>
      </nav>
      <button type="button" class="theme-toggle" data-theme-toggle aria-label="切換深色或淺色">外觀</button>
    </div>
  </header>
  {% set ticker = xposts | xTicker %}
  {% if ticker.posts.length %}
  <div class="x-ticker" data-x-ticker hidden role="region" aria-labelledby="x-ticker-label" style="--x-ticker-duration: {{ ticker.duration }}s">
    <div class="wrap x-ticker-inner">
      <p class="x-ticker-label" id="x-ticker-label">X 最新</p>
      <div class="x-ticker-viewport">
        <div class="x-ticker-track">
          {% for mirror in [false, true] %}
          <ul class="x-ticker-list"{% if mirror %} aria-hidden="true"{% endif %}>
            {%- for post in ticker.segment %}
            <li{% if mirror or post.repeat %} aria-hidden="true"{% endif %}>
              <a href="{{ post.url }}" target="_blank" rel="noopener"{% if mirror or post.repeat %} tabindex="-1"{% endif %}>{{ post.text }}</a>
            </li>
            {%- endfor %}
          </ul>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
  <script data-x-ticker-clock>
  (function () {
    var bar = document.querySelector("[data-x-ticker]");
    if (!bar) return;

    function sync() {
      var parts = new Intl.DateTimeFormat("en-US", {
        timeZone: "Asia/Taipei",
        hour: "2-digit",
        minute: "2-digit",
        hourCycle: "h23"
      }).formatToParts(new Date());
      var hour = NaN;
      var minute = NaN;
      var dayPeriod = "";
      var i;
      for (i = 0; i < parts.length; i++) {
        if (parts[i].type === "hour") hour = Number(parts[i].value);
        else if (parts[i].type === "minute") minute = Number(parts[i].value);
        else if (parts[i].type === "dayPeriod") dayPeriod = parts[i].value;
      }
      if (hour === 24) hour = 0;
      if (dayPeriod && /pm/i.test(dayPeriod) && hour < 12) hour += 12;
      if (dayPeriod && /am/i.test(dayPeriod) && hour === 12) hour = 0;
      var minutes = hour * 60 + minute;
      bar.hidden = !(Number.isFinite(minutes) && minutes >= 5 * 60 && minutes < 22 * 60);
    }

    sync();
    setInterval(sync, 60000);
  })();
  </script>
  {% endif %}
  <main id="main">
    <div class="wrap">
      {{ content | safe }}
    </div>
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <p class="footer-name">{{ site.name }} · {{ site.nameEn }}</p>
      <ul class="footer-links">
        <li><a href="/exclusives/">長文</a></li>
        <li><a href="/digests/">Digest</a></li>
        <li><a href="/about/">關於</a></li>
        <li><a href="/newsletter/">訂閱</a></li>
        <li><a href="/feed.xml">RSS</a></li>
      </ul>
      <p>© {{ "" | year }} {{ site.name }}</p>
      {% if page.url == "/" %}
      <p class="views" data-views="total" hidden>全站累計瀏覽 <span data-views-count></span> 次</p>
      {% endif %}
    </div>
  </footer>
  <script data-goatcounter="https://silverrebel71.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  <script src="/js/theme.js" defer></script>
  {% if kind or page.url == "/" %}
  <script src="/js/views.js" defer></script>
  {% endif %}
</body>
</html>
